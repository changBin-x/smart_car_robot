<?xml version="1.0"?>
<!-- ============================================================
     smartcar.urdf.xacro —— 四轮麦克纳姆小车网格模型（description 包）
     =====
     Author: ChangBin <bin_chang@qq.com>
     Date: 2026-07-22
     Description: 仅视觉/碰撞/惯量与 TF；不含 ros2_control。

     坐标系（与 meshes/chassis_origin.txt 一致，2026-07-22 重导出）：
       - base_footprint：地面投影，z=0。
       - base_link：底盘网格几何中心（世界 z≈0.05223 m），
         chassis.stl 顶点已居中到该点。
       - 轮心世界坐标：(±0.0675, ±0.08231, 0.03)；
         相对 base_link 的 z = wheel_radius - base_link_z。
     ============================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartcar">

  <!-- ===== 几何常量（单位 m）===== -->
  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="wheel_width" value="0.03062"/>
  <xacro:property name="wheelbase" value="0.135"/>
  <xacro:property name="track_width" value="0.16462"/>
  <!-- chassis.stl 导出时的几何中心高度（地面为 0） -->
  <xacro:property name="base_link_z" value="0.052234"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_z}"/>

  <!-- 包络碰撞（相对 base_link；覆盖板+Pi） -->
  <xacro:property name="base_length" value="0.220"/>
  <xacro:property name="base_width" value="0.192"/>
  <xacro:property name="base_height" value="0.145"/>
  <xacro:property name="base_mass" value="2.0"/>
  <xacro:property name="wheel_mass" value="0.15"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://smartcar_description/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_gray">
        <color rgba="0.18 0.18 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <!-- 碰撞盒中心与 visual 网格中心大致重合 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass/12.0*(base_width*base_width + base_height*base_height)}"
        iyy="${base_mass/12.0*(base_length*base_length + base_height*base_height)}"
        izz="${base_mass/12.0*(base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link 抬到网格几何中心高度，轮心世界 z 仍为 wheel_radius -->
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="prefix x_sign y_sign mesh_file">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://smartcar_description/meshes/${mesh_file}"/>
        </geometry>
        <material name="wheel_red">
          <color rgba="0.75 0.12 0.12 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <!-- 轮子惯量原点位于轮心（圆柱几何中心） -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${wheel_mass*wheel_radius*wheel_radius/2.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin
        xyz="${x_sign*wheelbase/2.0} ${y_sign*track_width/2.0} ${wheel_z}"
        rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"  mesh_file="wheel_left.stl"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1" mesh_file="wheel_right.stl"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"  mesh_file="wheel_right.stl"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1" mesh_file="wheel_left.stl"/>

</robot>
