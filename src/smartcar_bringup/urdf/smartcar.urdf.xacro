<?xml version="1.0"?>
<!-- ============================================================
     smartcar.urdf.xacro —— 四轮麦克纳姆小车主模型
     =====
     组成：一个 base_link 底盘 + 4 个连续旋转轮关节。
     所有几何量都是 xacro 参数（全局约束 2，不硬编码）：
       wheel_radius   轮半径 [m]
       wheelbase      前后轮轴距（前轴到后轴）[m]
       track_width    左右轮距（左轮到右轮）[m]
     轮子相对 base_link 的位置 = (±wheelbase/2, ±track_width/2)。

     注意：轴距/轮距须与实车测量一致（底盘 220×192×145 mm，麦轮厚 30 mm），
     见 docs/协议总结.md §7 Q7。它们同时决定：
       1) 轮子 link 的摆放（可视化 / TF）
       2) mecanum_drive_controller 的运动学参数（controllers.yaml 里
          的 sum_of_robot_center_projection_on_X_Y_axis = lx + ly，
          lx = wheelbase/2, ly = track_width/2）。
     两处必须用同一组数值，否则里程计与实际运动不自洽。
     ============================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smartcar">

  <!-- ===== 可覆盖参数（launch 通过 xacro 命令行传入） ===== -->
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="115200"/>

  <!-- ===== 几何常量（单位 m，2026-07-20 实车测量回填）===== -->
  <!-- 底盘外形：长 220 mm × 宽 192 mm × 高 145 mm；麦轮 Ø60 mm、厚 30 mm。
       轴距/轮距暂按底盘长宽近似（轮心距未单独卷尺时）；改此处时必须同步
       controllers.yaml 的 sum_of_robot_center_projection_on_X_Y_axis。 -->
  <xacro:property name="wheel_radius" value="0.03"/>   <!-- 麦轮 Ø60mm → r=0.03 -->
  <xacro:property name="wheel_width" value="0.03"/>    <!-- 轮厚 30 mm，仅可视化 -->
  <xacro:property name="wheelbase" value="0.220"/>     <!-- 前后轴距 ≈ 底盘长 -->
  <xacro:property name="track_width" value="0.192"/>   <!-- 左右轮距 ≈ 底盘宽 -->
  <xacro:property name="base_length" value="0.220"/>
  <xacro:property name="base_width" value="0.192"/>
  <xacro:property name="base_height" value="0.145"/>
  <xacro:property name="base_mass" value="2.0"/>
  <xacro:property name="wheel_mass" value="0.15"/>

  <!-- ===== 引入 ros2_control 硬件描述 ===== -->
  <xacro:include filename="$(find smartcar_bringup)/urdf/smartcar.ros2_control.xacro"/>

  <!-- ================= 底盘 ================= -->
  <!-- base_footprint：地面投影根坐标系，里程计的父系惯例落脚点 -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_gray">
        <color rgba="0.2 0.2 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <!-- 长方体惯量：I = m/12 * (a^2 + b^2) -->
      <inertia
        ixx="${base_mass/12.0*(base_width*base_width + base_height*base_height)}"
        iyy="${base_mass/12.0*(base_length*base_length + base_height*base_height)}"
        izz="${base_mass/12.0*(base_length*base_length + base_width*base_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- 底盘中心离地 = 轮半径 + 少量底盘厚度余量 -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ================= 轮子宏 ================= -->
  <!-- x_sign/y_sign: 前(+)/后(-)，左(+)/右(-)。轮绕 y 轴旋转（axis 0 1 0）。-->
  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <!-- 圆柱绕自转轴 izz = m*r^2/2；径向 = m/12*(3r^2 + h^2) -->
        <inertia
          ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${wheel_mass*wheel_radius*wheel_radius/2.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_sign*wheelbase/2.0} ${y_sign*track_width/2.0} 0"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- 四个轮子：命名与关节名严格对应全局约束 -->
  <xacro:wheel prefix="front_left"  x_sign="1"  y_sign="1"/>
  <xacro:wheel prefix="front_right" x_sign="1"  y_sign="-1"/>
  <xacro:wheel prefix="rear_left"   x_sign="-1" y_sign="1"/>
  <xacro:wheel prefix="rear_right"  x_sign="-1" y_sign="-1"/>

  <!-- ================= 挂载 ros2_control ================= -->
  <xacro:smartcar_ros2_control
      name="smartcar_system"
      use_mock_hardware="$(arg use_mock_hardware)"
      serial_port="$(arg serial_port)"
      baud_rate="$(arg baud_rate)"
      wheel_radius="${wheel_radius}"/>

</robot>
