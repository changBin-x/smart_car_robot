<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smartcar_bringup</name>
  <version>0.1.0</version>
  <description>
    四轮麦克纳姆小车的模型、控制器配置与启动包。
    提供 xacro 底盘模型（含 ros2_control 标签）、controllers.yaml
    （joint_state_broadcaster + mecanum_drive_controller）以及一键启动
    的 launch 文件。支持 use_mock_hardware 参数在 WSL2 无硬件环境仿真调试。
  </description>
  <maintainer email="user@todo.todo">smart_car_robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行期依赖：控制框架、控制器、模型工具、启动工具 -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>battery_state_broadcaster</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <!-- 实机硬件插件；mock 模式下不加载但仍声明依赖关系 -->
  <exec_depend>motor_driver</exec_depend>
  <!-- 实机 IMU；mock 模式下 launch 条件跳过，仍声明依赖便于解析 -->
  <exec_depend>ros2_mpu6050</exec_depend>
  <!-- 启动与遥控辅助 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
